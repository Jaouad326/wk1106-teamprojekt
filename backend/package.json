{
  "name": "studyprio-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/scripts/migrate.js",
    "test": "node --test tests/auth/*.test.js",
    "mail:check": "node --env-file-if-exists=.env src/scripts/check-mail.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "nodemailer": "^10.0.10",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  }
}
