# Kopieren nach backend/.env. Node.js >= 22.9 verwenden.
APP_ORIGIN=http://localhost:5173
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=studyprio.sqlite

# Nur Testdomain. Für echten Versand: mnd.thm.de ist durch die Kursmails belegt.
# Weitere Teamdomains jeweils ausdrücklich ergänzen, keine Wildcards verwenden.
ALLOWED_EMAIL_DOMAINS=campus.example
# local: Link nur im Backend-Terminal, kein Nachweis eines Mailboxzugriffs!
# smtp: echter Versand; dann alle SMTP-Felder ausfüllen.
MAIL_MODE=local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
